# ═══ انسخ الملف ده باسم .env وعدّل القيم ═══
#   cp .env.example .env

# قاعدة البيانات (PostgreSQL — لازم سيرفر خارجي، مثلاً Vercel Postgres / Neon / Supabase)
# متغير سيرفر فقط — متتحطش قيمته أبدًا في كود العميل أو تتعمله NEXT_PUBLIC_
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DBNAME?sslmode=require"

# سر توقيع جلسات الدخول — لازم تولّد واحد جديد خاص بيك (32 حرف على الأقل):
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET="CHANGE_ME_generate_a_new_secret"

# تخزين الصور (Vercel Blob) — لصور المنتجات وإثباتات الدفع
# سيرفر فقط — أبدًا NEXT_PUBLIC_. بيتضاف تلقائيًا لو ربطت Blob Store بالمشروع من Vercel Dashboard،
# أو محليًا شغّل: npx vercel env pull .env
BLOB_READ_WRITE_TOKEN=""

# (اختياري) بيانات الأدمن اللي بيتعمل بأمر npm run db:seed
# لو سيبتهم فاضيين هيتعمل: admin@syntax.eg / Admin@12345 — غيّرهم في الإنتاج!
# ADMIN_EMAIL="you@yourstore.com"
# ADMIN_PASSWORD="strong-password-here"
